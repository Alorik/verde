// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}



model Organization {
  id            String        @id @default(cuid())
  name          String        
  industry      Industry
  assessments   Assessment[]
  employeeCount Int
  country       String
  city          String?
  foundedAt   DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum Industry {
  TECHNOLOGY
  MANUFACTURING
  HEALTHCARE
  EDUCATION
  CONSTRUCTION
  ENERGY
  FINANCE
  OTHER
}

model Assessment{
  id                  String       @id @default(cuid())
  name                String
  reportingYear       Int
  status              AssessmentStatus
  documents            Document[]
  description         String?
  esgScore            ESGScore?
  organizationId      String
  organization        Organization @relation(fields: [organizationId],references: [id])

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
}

model Document {
  id            String    @id @default(cuid())
  fileName      String
  documentType  DocumentType
  fileSize      Int
  fileUrl       String?
  mimeType      String
  assessmentId  String
  electricity   Electricity?
  esgMetrics       ESGMetric[]
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  extractionStatus ExtractionStatus @default(PENDING)
  uploadedAt    DateTime    @default(now())
}

enum  DocumentType {
ELECTRICITY_BILL
  WATER_REPORT
  EMPLOYEE_DATA
  CSR_REPORT
  SUSTAINABILITY_REPORT
  OTHER
}

model Electricity {
  id                String   @id @default(cuid())
  documentId        String   @unique
  electricityCost   Decimal
  unitsConsumed     Decimal
 unit             MetricUnit?
consumptionMWh   Decimal?

  document Document @relation(fields: [documentId], references: [id])
}

model Water{
    id                String   @id @default(cuid())
  documentId        String   @unique
 WaterCost   Decimal
  unitsConsumed     Decimal
 unit             MetricUnit?
consumptionMWh   Decimal?

  document Document @relation(fields: [documentId], references: [id])
}

enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}


model ESGScore {
  id                 String      @id @default(cuid())
  assessmentId       String      @unique

  environmentalScore Decimal?
  socialScore        Decimal?
  governanceScore    Decimal?
  overallScore       Decimal?

  calculatedAt       DateTime    @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id])
  metrics   ESGMetric[]
}

model ESGMetric {
  id                 String      @id @default(cuid())
  esgScoreId         String

  name               String
  category           ESGCategory
  description        String?

  rawValue           Decimal?
  rawUnit            MetricUnit?

  normalizedValue    Decimal?
  normalizedUnit     MetricUnit?
      

  textValue          String?

  score              Decimal?
  weight             Decimal?

  sourceDocumentId   String?
  

  esgScore           ESGScore    @relation(fields: [esgScoreId], references: [id])
  sourceDocument     Document?   @relation(fields: [sourceDocumentId], references: [id])
}

enum ESGCategory {
  ENVIRONMENTAL
  SOCIAL
  GOVERNANCE
}



enum MetricUnit {
  MWH
  KWH
  PERCENT
  EMPLOYEES
  CUBIC_METER
  MWH_PER_EMPLOYEE
  NONE
}

