generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}



model Organization {
  id            String        @id @default(cuid())
  name          String        
  industry      Industry
  assessments   Assessment[]
  employeeCount Int
  country       String
  city          String?
  foundedAt   DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum Industry {
  TECHNOLOGY
  MANUFACTURING
  HEALTHCARE
  EDUCATION
  CONSTRUCTION
  ENERGY
  FINANCE
  OTHER
}

model Assessment{
  id                  String       @id @default(cuid())
  name                String
  reportingYear       Int
  status              AssessmentStatus
  document            Document[]
  description         String?
  organizationId      String
  organization        Organization @relation(fields: [organizationId],references: [id])

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

}

enum AssessmentStatus {
  DRAFT
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
}

model Document {
  id            String    @id @default(cuid())
  fileName      String
  documentType  DocumentType
  fileSize      Int
  fileUrl       String
  mimeType      String
  assessmentId  String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  uploadedAt    DateTime    @default(now())
}

enum  DocumentType {
ELECTRICITY_BILL
  WATER_REPORT
  EMPLOYEE_DATA
  CSR_REPORT
  SUSTAINABILITY_REPORT
  OTHER
}